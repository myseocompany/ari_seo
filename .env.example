# Credenciales de https://app.dataforseo.com/api-access
DATAFORSEO_LOGIN=
# Alias compatible: DATAFORSEO_USER
DATAFORSEO_PASSWORD=

# Opcionales. Recalibrar estimados con el pricing de la cuenta.
DATAFORSEO_TIMEOUT_MS=20000
DATAFORSEO_MAX_RETRIES=2
DATAFORSEO_CACHE_TTL_SECONDS=86400
DATAFORSEO_ESTIMATE_KEYWORDS_USD=0.05
DATAFORSEO_ESTIMATE_SERP_USD=0.01

# Token OAuth temporal con acceso de lectura a la propiedad de Search Console.
GOOGLE_SEARCH_CONSOLE_ACCESS_TOKEN=
# Opcional si el sitemap no vive en /sitemap.xml.
SCOUT_SITEMAP_URL=
