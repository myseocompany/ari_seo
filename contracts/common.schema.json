{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ari.dev/seo/contracts/common.schema.json",
  "title": "ARI SEO shared contract definitions",
  "$defs": {
    "ContractMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contract_version", "trace_id", "created_at", "producer"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "contract_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "trace_id": { "type": "string", "format": "uuid" },
        "created_at": { "type": "string", "format": "date-time" },
        "producer": { "type": "string", "enum": ["ari-scout", "ari-build", "ari-launch"] },
        "source_id": { "type": "string", "format": "uuid" }
      }
    },
    "ContractError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "message": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "details": { "type": "object", "additionalProperties": true }
      }
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "observed_at"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "observed_at": { "type": "string", "format": "date-time" },
        "note": { "type": "string" }
      }
    }
  }
}
