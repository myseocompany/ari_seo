{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ari.dev/seo/contracts/scout-request.schema.json",
  "title": "ScoutRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "trace_id", "topic", "locale", "location"],
  "properties": {
    "request_id": { "type": "string", "format": "uuid" },
    "trace_id": { "type": "string", "format": "uuid" },
    "topic": { "type": "string", "minLength": 1 },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "location": { "type": "string", "minLength": 1 },
    "site_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "search_console_site_url": {
      "type": "string",
      "minLength": 1,
      "anyOf": [
        { "format": "uri" },
        { "pattern": "^sc-domain:[a-zA-Z0-9.-]+$" }
      ]
    },
    "seed_keywords": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "competitor_domains": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,63}$"
      }
    },
    "target_audience": { "type": "string" },
    "conversion_goal": { "type": "string" },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_keywords": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 },
        "max_serp_queries": { "type": "integer", "minimum": 1, "maximum": 20, "default": 10 },
        "max_competitor_pages": { "type": "integer", "minimum": 0, "maximum": 10, "default": 5 },
        "max_gsc_rows": { "type": "integer", "minimum": 1, "maximum": 100000, "default": 25000 },
        "max_site_urls": { "type": "integer", "minimum": 1, "maximum": 50000, "default": 10000 },
        "provider_budget_usd": { "type": "number", "minimum": 0 }
      }
    }
  }
}
