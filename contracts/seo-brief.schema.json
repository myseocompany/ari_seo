{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ari.dev/seo/contracts/seo-brief.schema.json",
  "title": "SEOBrief",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "status", "topic", "search_intent", "keywords", "recommended_page", "evidence", "errors"],
  "properties": {
    "metadata": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/ContractMetadata" },
        { "properties": { "producer": { "const": "ari-scout" } } }
      ]
    },
    "status": { "type": "string", "enum": ["draft", "partial", "ready", "failed"] },
    "topic": { "type": "string", "minLength": 1 },
    "locale": { "type": "string", "description": "BCP 47 language tag, optionally including region." },
    "search_intent": { "type": "string", "enum": ["informational", "navigational", "commercial", "transactional", "mixed"] },
    "keywords": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary"],
      "properties": {
        "primary": { "type": "string", "minLength": 1 },
        "secondary": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "clusters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "terms"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "terms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    },
    "recommended_page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_type", "working_title", "slug", "outline"],
      "properties": {
        "page_type": { "type": "string", "minLength": 1 },
        "working_title": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "outline": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "conversion_goal": { "type": "string" },
        "internal_link_targets": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "competitor_urls": { "type": "array", "uniqueItems": true, "items": { "type": "string", "format": "uri" } },
    "evidence": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/Evidence" } },
    "assumptions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "errors": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/ContractError" } }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
      "then": { "properties": { "errors": { "minItems": 1 } } }
    }
  ]
}
